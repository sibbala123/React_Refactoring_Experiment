diff --git a/src/utils/formatters.jsx b/src/utils/formatters.jsx
new file mode 100644
--- /dev/null
+++ b/src/utils/formatters.jsx
@@ -0,0 +1,28 @@
+import React from 'react';

+export function formatCurrency(n) {
+  return new Intl.NumberFormat('en-US', {
+    style: 'currency',
+    currency: 'USD',
+    maximumFractionDigits: 0,
+  }).format(n);
+}

+export function getBadgeColor(status) {
+  if (status === 'Ready') return '#1d8348'
+  if (status === 'Draft') return '#af601a'
+  if (status === 'Blocked') return '#b03a2e'
+  return '#4d5656';
+}